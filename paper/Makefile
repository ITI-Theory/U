.PHONY: all help omnibus omnibus-royal omnibus-a4 \
	omnibus-translations translate-omnibus translate-omnibus-deepl \
	clean check setup freeze \
	de fr it translations translations-clean translate translate-deepl everything-bundle

all: $(_ALL_EN_PDFS) omnibus | $(BUILDDIR)

help:
	@echo "Soma-Field Papers -- PDF Build System"
	@echo ""
	@echo "  make             build all English PDFs"
	@echo "  make omnibus     both omnibus editions (Royal + A4)"
	@echo "  make de/fr/it    all PDFs in that language"
	@echo "  make wave-atlas  Wave Atlas book"
	@echo "  make clean       remove English PDFs"
	@echo "  make check       verify pandoc + xelatex"
	@echo ""
	@echo "Registered documents (make <alias>):"
	@printf '%s\n' $(foreach d,$(ALL_DOCS),'  $($(d).alias)  [$($(d).class), $($(d).langs)]  $(d)')

# (alias targets generated by register macro in mk/common.mk)

# Shared omnibus base flags (no geometry — set per variant)
OMNIBUS_BASE := $(RENDER_COMMON) \
	--toc-depth=2 \
	-V header-includes="\usepackage{amsmath}\usepackage{amssymb}" \
  $(CITEPROC)

# Omnibus — Royal (156×234 mm), sewn case-bound
# Print spec: 115–120 gsm cream offset | sewn case bound | matte cover
# bindingoffset=6mm: inner+binding ≈ 28 mm at gutter
OMNIBUS_ROYAL_FLAGS := $(OMNIBUS_BASE) \
  -V "geometry=paperwidth=156mm,paperheight=234mm,twoside,inner=22mm,outer=18mm,top=22mm,bottom=25mm,bindingoffset=6mm" \
  -V fontsize=10pt \
  -V linestretch=1.3

# Omnibus — A4 duplex, punched for Filofax ring binder
# inner=28mm leaves clearance for standard ISO-838 punch (holes at ~12mm from edge)
OMNIBUS_A4_FLAGS := $(OMNIBUS_BASE) \
  -V "geometry=a4paper,twoside,inner=28mm,outer=20mm,top=20mm,bottom=22mm" \
  -V fontsize=11pt \
  -V linestretch=1.4

omnibus-royal: | $(BUILDDIR)
	$(PYTHON) $(SCRIPTS)/build_omnibus.py
	$(PANDOC) $(BUILDDIR)/omnibus-body.md -o $(BUILDDIR)/omnibus-royal.pdf $(OMNIBUS_ROYAL_FLAGS)
	@echo "Built: $(BUILDDIR)/omnibus-royal.pdf"

omnibus-a4: | $(BUILDDIR)
	$(PYTHON) $(SCRIPTS)/build_omnibus.py
	$(PANDOC) $(BUILDDIR)/omnibus-body.md -o $(BUILDDIR)/omnibus-a4.pdf $(OMNIBUS_A4_FLAGS)
	@echo "Built: $(BUILDDIR)/omnibus-a4.pdf"

omnibus: omnibus-royal omnibus-a4

translate-omnibus: | $(BUILDDIR)
	$(PYTHON) $(SCRIPTS)/translate_papers.py omnibus-body --model gpt-4o-mini

translate-omnibus-deepl: | $(BUILDDIR)
	$(PYTHON) $(SCRIPTS)/translate_papers.py omnibus-body --backend deepl

define BUILD_OMNIBUS_TRANS_RULE
.PHONY: omnibus-royal-$(1) omnibus-a4-$(1)
omnibus-royal-$(1): | $(BUILDDIR)
	$(PANDOC) $(BUILDDIR)/omnibus-body.$(1).md -o $(BUILDDIR)/omnibus-royal.$(1).pdf $(OMNIBUS_ROYAL_FLAGS) -V lang=$(1)
	@echo "Built: $(BUILDDIR)/omnibus-royal.$(1).pdf"
omnibus-a4-$(1): | $(BUILDDIR)
	$(PANDOC) $(BUILDDIR)/omnibus-body.$(1).md -o $(BUILDDIR)/omnibus-a4.$(1).pdf $(OMNIBUS_A4_FLAGS) -V lang=$(1)
	@echo "Built: $(BUILDDIR)/omnibus-a4.$(1).pdf"
endef
$(foreach l,de fr it,$(eval $(call BUILD_OMNIBUS_TRANS_RULE,$(l))))
omnibus-translations: omnibus-royal-de omnibus-royal-fr omnibus-royal-it omnibus-a4-de omnibus-a4-fr omnibus-a4-it

# --- Rule generation from registry ---
# EN rule: source via vpath; flags + citeproc derived from doc class
define BUILD_EN_RULE
$(BUILDDIR)/$(1).pdf: $(1).md $(if $(filter citeproc,$($(1).class)),$(BIB),) | $(BUILDDIR)
	$(PANDOC) $$< -o $$@ $(if $(filter book,$($(1).class)),$(BOOK_FLAGS),$(FLAGS)) $(if $(filter citeproc,$($(1).class)),$(CITEPROC),)
	@echo "Built: $$@"
endef

# Translation rule: source from bld/; flags derived from doc class × lang
define BUILD_TRANS_RULE
$(BUILDDIR)/$(1).$(2).pdf: $(BUILDDIR)/$(1).$(2).md $(if $(filter citeproc,$($(1).class)),$(BIB),) | $(BUILDDIR)
	$(PANDOC) $$< -o $$@ $(if $(filter book,$($(1).class)),$(BOOK_FLAGS_$(2)),$(FLAGS_$(2))) $(if $(filter citeproc,$($(1).class)),$(CITEPROC),)
	@echo "Built: $$@"
endef

TRANS_LANGS := de fr it
$(foreach d,$(ALL_DOCS),$(eval $(call BUILD_EN_RULE,$(d))))
$(foreach d,$(ALL_DOCS),$(foreach l,$(TRANS_LANGS),$(if $(filter multi,$($(d).langs)),$(eval $(call BUILD_TRANS_RULE,$(d),$(l))),)))

# -----------------------------------------------------------------------------
# Wave Atlas — coffee-table book (in drafting)
# Royal 156x234mm sewn case-bound, twoside, openany.
# Source: soma/wave-atlas/*.md (numbered prefix sets concatenation order).
# -----------------------------------------------------------------------------
WAVE_ATLAS_DIR := soma/wave-atlas
WAVE_ATLAS_SRC := $(sort $(wildcard $(WAVE_ATLAS_DIR)/[0-9]*.md))

WAVE_ATLAS_COMMON := $(RENDER_COMMON) \
  --resource-path=soma/wave-atlas:soma/wave-atlas/figures \
  -V documentclass=book \
	-V classoption=openany

WAVE_ATLAS_HEADER_MICRO := -V header-includes="\usepackage{amsmath}\usepackage{amssymb}\usepackage{microtype}\usepackage[most]{tcolorbox}"
WAVE_ATLAS_HEADER_GRAPHIC := -V header-includes="\usepackage{amsmath}\usepackage{amssymb}\usepackage{microtype}\usepackage[most]{tcolorbox}\usepackage{graphicx}\graphicspath{{./}{soma/wave-atlas/figures/}{figures/}}"

WAVE_ATLAS_ROYAL_FLAGS := $(WAVE_ATLAS_COMMON) \
  -V "geometry=paperwidth=156mm,paperheight=234mm,twoside,inner=22mm,outer=18mm,top=22mm,bottom=25mm,bindingoffset=6mm" \
  -V fontsize=11pt \
  -V linestretch=1.35 \
  $(WAVE_ATLAS_HEADER_GRAPHIC)

WAVE_ATLAS_A4_FLAGS := $(WAVE_ATLAS_COMMON) \
  -V "geometry=a4paper,twoside,inner=28mm,outer=20mm,top=22mm,bottom=22mm" \
  -V fontsize=11pt \
  -V linestretch=1.4 \
  $(WAVE_ATLAS_HEADER_MICRO)

# Crown Quarto experiment — 189×246mm (larger than Royal 156×234, OpenStax-ish feel).
WAVE_ATLAS_CROWN_FLAGS := $(WAVE_ATLAS_COMMON) \
  -V "geometry=paperwidth=189mm,paperheight=246mm,twoside,inner=24mm,outer=20mm,top=24mm,bottom=26mm,bindingoffset=6mm" \
  -V fontsize=11pt \
  -V linestretch=1.35 \
  $(WAVE_ATLAS_HEADER_GRAPHIC)

.PHONY: wave-atlas wave-atlas-a4 wave-atlas-all wave-atlas-crown

wave-atlas: | $(BUILDDIR)
	@echo "Wave Atlas sources:"
	@for f in $(WAVE_ATLAS_SRC); do echo "  $$f"; done
	$(PANDOC) $(WAVE_ATLAS_SRC) -o $(BUILDDIR)/wave-atlas.pdf $(WAVE_ATLAS_A4_FLAGS)
	@echo "Built: $(BUILDDIR)/wave-atlas.pdf (A4 — default)"

wave-atlas-royal: | $(BUILDDIR)
	$(PANDOC) $(WAVE_ATLAS_SRC) -o $(BUILDDIR)/wave-atlas-royal.pdf $(WAVE_ATLAS_ROYAL_FLAGS)
	@echo "Built: $(BUILDDIR)/wave-atlas-royal.pdf"

wave-atlas-all: wave-atlas wave-atlas-a4

wave-atlas-crown: | $(BUILDDIR)
	@echo "Building Wave Atlas (Crown Quarto 189×246mm) from $(words $(WAVE_ATLAS_SRC)) source files..."
	$(PANDOC) $(WAVE_ATLAS_SRC) -o $(BUILDDIR)/wave-atlas-crown.pdf $(WAVE_ATLAS_CROWN_FLAGS)
	@echo "Built: $(BUILDDIR)/wave-atlas-crown.pdf"

# Wave Atlas translations — assemble body, translate via LLM, build PDFs.
# Requires OPENAI_API_KEY in paper/.keys.local for translate-wave-atlas,
# or DEEPL_API_KEY for translate-wave-atlas-deepl.

WAVE_ATLAS_BODY := $(BUILDDIR)/wave-atlas-body.md

$(WAVE_ATLAS_BODY): $(WAVE_ATLAS_SRC) | $(BUILDDIR)
	cat $(WAVE_ATLAS_SRC) > $@
	@echo "Assembled: $@ ($$(wc -w < $@) words)"

.PHONY: wave-atlas-body translate-wave-atlas translate-wave-atlas-deepl wave-atlas-translations

wave-atlas-body: $(WAVE_ATLAS_BODY)

translate-wave-atlas: $(WAVE_ATLAS_BODY)
	$(PYTHON) $(SCRIPTS)/translate_papers.py wave-atlas-body --model gpt-4o-mini

translate-wave-atlas-deepl: $(WAVE_ATLAS_BODY)
	$(PYTHON) $(SCRIPTS)/translate_papers.py wave-atlas-body --backend deepl

define BUILD_WAVE_TRANS_RULE
.PHONY: wave-atlas-$(1)
wave-atlas-$(1): | $(BUILDDIR)
	$(PANDOC) $(BUILDDIR)/wave-atlas-body.$(1).md -o $(BUILDDIR)/wave-atlas.$(1).pdf $(WAVE_ATLAS_ROYAL_FLAGS) -V lang=$(1)
	@echo "Built: $(BUILDDIR)/wave-atlas.$(1).pdf"
endef
$(foreach l,de fr it,$(eval $(call BUILD_WAVE_TRANS_RULE,$(l))))
wave-atlas-translations: wave-atlas-de wave-atlas-fr wave-atlas-it

$(BUILDDIR)/%.pdf: %.md $(BIB) | $(BUILDDIR)
	$(PANDOC) $< -o $@ $(FLAGS) # $(CITE_FLAGS)
	@echo "Built: $@"

include mk/utils.mk

# Individual-paper translations — run make translate (LLM) or make translate-deepl first.

translate:
	$(PYTHON) $(SCRIPTS)/translate_papers.py --backend llm

translate-deepl:
	$(PYTHON) $(SCRIPTS)/translate_papers.py --backend deepl

.PHONY: translate translate-deepl

translations: $(PDFS_DE) $(PDFS_FR) $(PDFS_IT)

de: $(PDFS_DE)

fr: $(PDFS_FR)

it: $(PDFS_IT)

translations-clean:
	rm -f $(PDFS_DE) $(PDFS_FR) $(PDFS_IT)

everything-bundle:
	cd .. && ./.venv/Scripts/python.exe scripts/package_everything.py --version v1.0.0

# --- Standard papers (FLAGS only) — pattern rules ---

$(BUILDDIR)/%.de.pdf: $(BUILDDIR)/%.de.md | $(BUILDDIR)
	$(PANDOC) $< -o $@ $(FLAGS_DE)
	@echo "Built: $@"

$(BUILDDIR)/%.fr.pdf: $(BUILDDIR)/%.fr.md | $(BUILDDIR)
	$(PANDOC) $< -o $@ $(FLAGS_FR)
	@echo "Built: $@"

$(BUILDDIR)/%.it.pdf: $(BUILDDIR)/%.it.md | $(BUILDDIR)
	$(PANDOC) $< -o $@ $(FLAGS_IT)
	@echo "Built: $@"
# -----------------------------------------------------------------------------
# Phase Dot — the Conversations book (assembled from Me/chats by
# Me/chats/assemble_book.py).  Royal 156x234mm sewn + A4 duplex.
# -----------------------------------------------------------------------------
PHASE_DOT_SRC := soma/phase-dot/phase-dot.md

PHASE_DOT_COMMON := $(RENDER_COMMON) \
  --from=markdown-tex_math_dollars-tex_math_single_backslash-tex_math_double_backslash-raw_tex \
  --toc-depth=1 \
  -V documentclass=book \
  -V classoption=openany \
	-V header-includes="\usepackage{amsmath}\usepackage{amssymb}\usepackage{microtype}"

PHASE_DOT_ROYAL_FLAGS := $(PHASE_DOT_COMMON) \
  -V "geometry=paperwidth=156mm,paperheight=234mm,twoside,inner=22mm,outer=18mm,top=22mm,bottom=25mm,bindingoffset=6mm" \
  -V fontsize=11pt \
  -V linestretch=1.35

PHASE_DOT_A4_FLAGS := $(PHASE_DOT_COMMON) \
  -V "geometry=a4paper,twoside,inner=28mm,outer=20mm,top=22mm,bottom=22mm" \
  -V fontsize=11pt \
  -V linestretch=1.4

# Phase Dot — Letter + two-column, Lulu HC binding (volume-reduction experiment)
# Goal: fit the full conversations book under Lulu 480pp limit (80# coated).
# Wider page (215.9mm) + twocolumn reduces page count vs A4 one-column.
# Three font sizes bracket the 480pp target; build all three and compare.
# Geometry: Lulu HC Linen Wrap Letter — inner=22mm + bindingoffset=6mm ≈ 28mm
#           outer=13mm, top/bottom=19mm, columnsep=6mm.
PHASE_DOT_LETTER_LULU2COL_COMMON := \
  --pdf-engine=$(ENGINE) \
  --from=markdown-tex_math_dollars-tex_math_single_backslash-tex_math_double_backslash-raw_tex \
  --standalone \
  --toc \
  --toc-depth=1 \
  -V documentclass=book \
  -V classoption="openany,twocolumn" \
  -V "geometry=letterpaper,twoside,inner=22mm,outer=13mm,top=19mm,bottom=22mm,bindingoffset=6mm,columnsep=6mm" \
  -V colorlinks=true \
  -V linkcolor=NavyBlue \
  -V urlcolor=NavyBlue \
  -V toccolor=NavyBlue \
  -V hyperxmp=false \
  -V monofont="Consolas" \
  -V header-includes="\usepackage{amsmath}\usepackage{amssymb}\usepackage{microtype}" \
  --lua-filter=strip-keywords.lua \
  --lua-filter=twocolumn-tables.lua \
  --lua-filter=chat-headers.lua \
  -H chat-head.tex

PHASE_DOT_LETTER_LULU2COL_10_FLAGS := $(PHASE_DOT_LETTER_LULU2COL_COMMON) \
  -V fontsize=10pt \
  -V linestretch=1.2

PHASE_DOT_LETTER_LULU2COL_11_FLAGS := $(PHASE_DOT_LETTER_LULU2COL_COMMON) \
  -V fontsize=11pt \
  -V linestretch=1.25

PHASE_DOT_LETTER_LULU2COL_12_FLAGS := $(PHASE_DOT_LETTER_LULU2COL_COMMON) \
  -V fontsize=12pt \
  -V linestretch=1.3

.PHONY: phase-dot phase-dot-a4 phase-dot-all phase-dot-assemble \
        translate-phase-dot translate-phase-dot-deepl \
        phase-dot-translations phase-dot-royal-lulu phase-dot-a4-lulu \
        phase-dot-letter-lulu2col-all

phase-dot-assemble:
	$(PYTHON) ../../../Me/chats/assemble_book.py

phase-dot: | $(BUILDDIR)
	$(PANDOC) $(PHASE_DOT_SRC) -o $(BUILDDIR)/phase-dot.pdf $(PHASE_DOT_ROYAL_FLAGS)
	@echo "Built: $(BUILDDIR)/phase-dot.pdf"

phase-dot-a4: | $(BUILDDIR)
	$(PANDOC) $(PHASE_DOT_SRC) -o $(BUILDDIR)/phase-dot-a4.pdf $(PHASE_DOT_A4_FLAGS)
	@echo "Built: $(BUILDDIR)/phase-dot-a4.pdf"

phase-dot-all: phase-dot phase-dot-a4

# Descriptive aliases — size + output made explicit
phase-dot-royal-lulu: phase-dot
phase-dot-a4-lulu: phase-dot-a4

# Letter two-column variants (volume-reduction experiment)
define BUILD_PHASE_DOT_2COL_RULE
.PHONY: phase-dot-letter-lulu2col-$(1)
phase-dot-letter-lulu2col-$(1): | $(BUILDDIR)
	$(PANDOC) $(PHASE_DOT_SRC) -o $(BUILDDIR)/phase-dot-letter-lulu2col-$(1).pdf $(PHASE_DOT_LETTER_LULU2COL_$(1)_FLAGS)
	@echo "Built: $(BUILDDIR)/phase-dot-letter-lulu2col-$(1).pdf"
endef
$(foreach s,10 11 12,$(eval $(call BUILD_PHASE_DOT_2COL_RULE,$(s))))
phase-dot-letter-lulu2col-all: phase-dot-letter-lulu2col-10 phase-dot-letter-lulu2col-11 phase-dot-letter-lulu2col-12

translate-phase-dot:
	$(PYTHON) $(SCRIPTS)/translate_papers.py phase-dot --model gpt-4o-mini

translate-phase-dot-deepl:
	$(PYTHON) $(SCRIPTS)/translate_papers.py phase-dot --backend deepl

define BUILD_PHASE_TRANS_RULE
.PHONY: phase-dot-$(1)
phase-dot-$(1): | $(BUILDDIR)
	$(PANDOC) $(BUILDDIR)/phase-dot.$(1).md -o $(BUILDDIR)/phase-dot.$(1).pdf $(PHASE_DOT_ROYAL_FLAGS) -V lang=$(1)
	@echo "Built: $(BUILDDIR)/phase-dot.$(1).pdf"
endef
$(foreach l,de fr it,$(eval $(call BUILD_PHASE_TRANS_RULE,$(l))))
phase-dot-translations: phase-dot-de phase-dot-fr phase-dot-it
