{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "gym_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "vendor_ref": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "qty": { "type": "integer" },
          "state": { "type": "string" },
          "area": { "type": "string" },
          "url": { "type": "string" },
          "attrs": { "type": "object" },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "url": { "type": "string" }
              },
              "required": ["type","url"]
            }
          }
        },
        "required": ["id","name","type","qty","state","area"]
      }
    }
  }
}
