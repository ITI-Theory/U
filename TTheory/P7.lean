import TTheory.P1

/-!
# P7 · Field Notes from the Inside

*A Patient-Constructed Model of Emotional Dynamics*

[T]-Theory's seventh document, as Lean. Source:
`paper/soma/soma-field-patient-pov/soma-field-patient-pov.md`; its id, title and DOI are in
`Dist/PAPERS.yaml` (P7).

P7 tells the model from the inside; its mathematics is P1's, and here P1's witnesses carry it.
What P7 adds is checked: the reading of its threshold table, the minima of its energy figure, the
operator modifications (ADHD's noise scale, the claim that the composed conditions do not commute),
and what an antisymmetric coupling does, which is circling, not a limit cycle by itself.
-/

namespace TTheory.P7

open TTheory

/-! ## The perception threshold and its table

"Emotion `i` is consciously perceived iff `|E_i(t)| > T_i`": P1's eq. (12). Table 1 reads
alexithymia as an elevated threshold and hypervigilance as a lowered one: raising the threshold can
only remove what is perceived. -/

/-- A higher threshold perceives only what a lower one does. -/
theorem threshold_antitone {n : ℕ} {T T' : Fin n → ℝ} (h : ∀ i, T i ≤ T' i) (E : Fin n → ℝ)
    (i : Fin n) : P1.Perceived T' E i → P1.Perceived T E i :=
  fun hp => lt_of_le_of_lt (h i) hp

/-! ## The energy figure

"`U = x⁴/4 - x²/2 + 0.035x` ... expect_minima = -1.017, 0.982". Its slope `x³ - x + 0.035` changes
sign within a thousandth of each, and is rising there (`3x² - 1 > 0`), so each is a minimum. -/

/-- The figure's slope. -/
def slope (x : ℝ) : ℝ := x ^ 3 - x + 0.035

theorem slope_continuous : Continuous slope := by unfold slope; fun_prop

/-- A root of the slope in (0.981, 0.983) and one in (-1.018, -1.016), each where the curvature is
    positive. -/
theorem figure_minima :
    (∃ x ∈ Set.Ioo (0.981 : ℝ) 0.983, slope x = 0 ∧ 0 < 3 * x ^ 2 - 1) ∧
    (∃ x ∈ Set.Ioo (-1.018 : ℝ) (-1.016), slope x = 0 ∧ 0 < 3 * x ^ 2 - 1) := by
  constructor
  · obtain ⟨x, hx, h0⟩ := intermediate_value_Ioo (by norm_num : (0.981 : ℝ) ≤ 0.983)
      slope_continuous.continuousOn (show (0 : ℝ) ∈ Set.Ioo (slope 0.981) (slope 0.983) by
        constructor <;> norm_num [slope])
    exact ⟨x, hx, h0, by nlinarith [hx.1]⟩
  · obtain ⟨x, hx, h0⟩ := intermediate_value_Ioo (by norm_num : (-1.018 : ℝ) ≤ -1.016)
      slope_continuous.continuousOn (show (0 : ℝ) ∈ Set.Ioo (slope (-1.018)) (slope (-1.016)) by
        constructor <;> norm_num [slope])
    exact ⟨x, hx, h0, by nlinarith [hx.2]⟩

/-! ## C-PTSD: the antisymmetric part of the coupling

"C-PTSD also breaks the symmetry of the coupling matrix `W`, admitting limit cycles ... generated by
the antisymmetric component of `W`." An antisymmetric coupling does no work on the state:
`eᵀAe = 0`, so under `ė = Ae` the length `|e|²` never changes and the state circles instead of
descending (no gradient flow can do that). A *limit* cycle, an isolated attracting orbit, needs
more: the linear antisymmetric part gives neutral circles, so the claim as written stays open. -/

/-- An antisymmetric coupling does no work: `Σᵢ eᵢ Σⱼ Aᵢⱼ eⱼ = 0`. -/
theorem antisymmetric_no_work {n : ℕ} (A : Fin n → Fin n → ℝ) (hA : ∀ i j, A i j = -A j i)
    (e : Fin n → ℝ) : ∑ i, e i * ∑ j, A i j * e j = 0 := by
  have h : ∑ i, e i * ∑ j, A i j * e j = ∑ i, ∑ j, A i j * e i * e j := by
    simp only [Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
  have hs : ∑ i, ∑ j, A i j * e i * e j = -∑ i, ∑ j, A i j * e i * e j := by
    conv_lhs => rw [Finset.sum_comm]
    simp only [← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by rw [hA j i]; ring
  linarith

/-! ## ADHD: the noise scale

"`γ_ADHD ė = -∇H + √(2 D_ADHD) ξ`": the noise per unit damping is `√(2D/γ)`, which rises with `D`
and falls with `γ`; the figure checks 2 at `D = 1`, `γ = 0.5`. -/

/-- The noise scale. -/
noncomputable def noiseScale (D γ : ℝ) : ℝ := Real.sqrt (2 * D / γ)

theorem noise_checked : noiseScale 1 0.5 = 2 := by
  rw [noiseScale, show (2 : ℝ) * 1 / 0.5 = 2 ^ 2 by norm_num]
  exact Real.sqrt_sq (by norm_num)

theorem noise_monotone {D D' γ γ' : ℝ} (hD : 0 ≤ D) (hDD : D ≤ D') (hγ : 0 < γ') (hγγ : γ' ≤ γ) :
    noiseScale D γ ≤ noiseScale D' γ' := by
  apply Real.sqrt_le_sqrt
  have hγ0 : 0 < γ := lt_of_lt_of_le hγ hγγ
  rw [div_le_div_iff₀ hγ0 hγ]
  nlinarith

/-! ## "The composition does not commute"

Each condition wraps the dynamics: ADHD divides the drift by its damping `γ`, C-PTSD adds the
memory term `m`. In one order the memory term is damped, in the other it is not: they differ
whenever `γ ≠ 1` and `m ≠ 0`. -/

/-- ADHD on a drift: divide by the damping. -/
noncomputable def adhd (γ : ℝ) (f : ℝ) : ℝ := f / γ

/-- C-PTSD on a drift: add the memory term. -/
def cptsd (m : ℝ) (f : ℝ) : ℝ := f + m

theorem not_commute : adhd 2 (cptsd 1 0) ≠ cptsd 1 (adhd 2 0) := by
  norm_num [adhd, cptsd]

/-! ## P7's claims -/

def cThreshold : Claim where
  id := "P7.threshold"
  text := "Perceived only when a local amplitude exceeds a threshold (P1's eq. 12); an elevated \
    threshold (alexithymia) perceives only part of what a lowered one (hypervigilance) does."
  statement := P1.cThreshold.statement ∧ ∀ n (T T' : Fin n → ℝ), (∀ i, T i ≤ T' i) →
    ∀ (E : Fin n → ℝ) (i : Fin n), P1.Perceived T' E i → P1.Perceived T E i

instance [h : Witness P1.cThreshold] : Witness cThreshold :=
  .of ⟨h.proof, fun _ _ _ hT E i => threshold_antitone hT E i⟩

def cDownhill : Claim where
  id := "P7.energy"
  text := "Governed by an energy function, borrowed from Hopfield, that drives the field toward \
    stable attractor states (P1)."
  statement := P1.cDownhill.statement

instance [h : Witness P1.cDownhill] : Witness cDownhill := .of h.proof

def cFreeze : Claim where
  id := "P7.freeze"
  text := "Freeze is isolated: escape requires first increasing the field's energy (P1)."
  statement := P1.cEscape.statement

instance [h : Witness P1.cEscape] : Witness cFreeze := .of h.proof

def cFigure : Claim where
  id := "P7.figure"
  text := "The energy slice U = x⁴/4 - x²/2 + 0.035x has its minima at -1.017 and 0.982."
  statement := (∃ x ∈ Set.Ioo (0.981 : ℝ) 0.983, slope x = 0 ∧ 0 < 3 * x ^ 2 - 1) ∧
    (∃ x ∈ Set.Ioo (-1.018 : ℝ) (-1.016), slope x = 0 ∧ 0 < 3 * x ^ 2 - 1)

instance : Witness cFigure := .of figure_minima

def cCircling : Claim where
  id := "P7.antisymmetric"
  text := "The antisymmetric component of W does no work on the state: it circles rather than \
    descends."
  statement := ∀ n (A : Fin n → Fin n → ℝ), (∀ i j, A i j = -A j i) → ∀ e : Fin n → ℝ,
    ∑ i, e i * ∑ j, A i j * e j = 0

instance : Witness cCircling := .of fun _ A hA e => antisymmetric_no_work A hA e

/-- That the C-PTSD dynamics has a limit cycle: named, not defined here (P7 gives no nonlinear
    terms to define it with). -/
opaque cptsdLimitCycle : Prop

/-- The limit cycle itself: an isolated attracting orbit of the C-PTSD dynamics. Stated, open: the
    linear antisymmetric part alone gives neutral circles, so a limit cycle needs the nonlinear
    terms, which P7 does not give. -/
def cLimitCycle : Claim where
  id := "P7.limit-cycle"
  text := "The oscillation between hyperarousal and shutdown is a limit cycle generated by the \
    antisymmetric component of W."
  statement := cptsdLimitCycle

def cNoise : Claim where
  id := "P7.adhd"
  text := "ADHD: less damping and more noise; the noise scale √(2D/γ) is 2 at D = 1, γ = 0.5, and \
    rises with D and falls with γ."
  statement := noiseScale 1 0.5 = 2 ∧ ∀ D D' γ γ' : ℝ, 0 ≤ D → D ≤ D' → 0 < γ' → γ' ≤ γ →
    noiseScale D γ ≤ noiseScale D' γ'

instance : Witness cNoise :=
  .of ⟨noise_checked, fun _ _ _ _ h1 h2 h3 h4 => noise_monotone h1 h2 h3 h4⟩

def cCompose : Claim where
  id := "P7.compose"
  text := "The composition does not commute; order matters."
  statement := ∃ γ m f : ℝ, adhd γ (cptsd m f) ≠ cptsd m (adhd γ f)

instance : Witness cCompose := .of ⟨2, 1, 0, not_commute⟩

/-- P7's claims, in the paper's order. -/
def claims : List Claim :=
  [cThreshold, cDownhill, cFigure, cFreeze, cCompose, cCircling, cLimitCycle, cNoise]

/-- P7's abstract, phrase by phrase. -/
def abstract : List (String × Claim) :=
  [("perceived only when a local amplitude exceeds a threshold", cThreshold),
   ("governed by an energy function — borrowed from Hopfield network theory — that drives the \
      field toward stable attractor states", cDownhill),
   ("mathematical operator modifications for Autism Spectrum Condition, ADHD, and Complex PTSD",
      cCompose)]

#status claims

#covers abstract claims

end TTheory.P7
