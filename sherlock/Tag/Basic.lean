/-!
# The {{usc:...}} tags as a model (USC; ISS-126)

The grammar is `sherlock/usc_tags.ebnf` (the author's, 26 Nov, with the 27 Nov extension for ideas). A
document is one line of text; the tags make it a tree. A fork's branches that were offered but not taken
are COUNTERFACTUAL, a jump outside the options is WILDCARD, and a span marked IDEA is a good idea or a
stray remark kept where it was said, with its triage (disp) and witness (ref) on the tag itself.
Generated by `sherlock/usctags.py lean`; questions in `TagQueries.lean`.
-/

namespace Tag

inductive Kind where
  | begin | «end» | fork | branch | jump
  deriving Repr, DecidableEq

structure Tag where
  file : String
  line : Nat
  kind : Kind
  id : String := ""
  ref : String := ""
  status : String := ""
  domain : String := ""
  lean : String := ""
  choice : String := ""
  prob : String := ""
  opts : String := ""
  disp : String := ""
  note : String := ""
  deriving Repr

/-- Ideas: spans marked IDEA. -/
def ideas (ts : List Tag) : List Tag := ts.filter fun t => t.kind == .begin && t.status == "IDEA"

/-- An idea is triaged when it carries a disposition (with a ref where one is required). -/
def Tag.triaged (t : Tag) : Bool :=
  t.disp == "parked" || t.disp == "discarded" ||
  ((t.disp == "implemented" || t.disp == "queued") && !t.ref.isEmpty)

/-- Open branches: offered at a fork, not taken. -/
def counterfactuals (ts : List Tag) : List Tag :=
  ts.filter fun t => t.kind == .branch && t.status == "COUNTERFACTUAL"

/-- Wildcards: the jumps outside the offered options. -/
def wildcards (ts : List Tag) : List Tag := ts.filter fun t => t.kind == .jump

end Tag
