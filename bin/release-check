#!/usr/bin/env bash
# U/bin/release-check — pre-release checks
# Run from repo root: bin/release-check
# Exit 0 = all checks pass; exit 1 = failures found

REPO=$(cd "$(dirname "$0")/.." && pwd)
PASS=0; FAIL=0; WARN=0

ok()   { echo "  PASS  $1"; PASS=$((PASS+1)); }
fail() { echo "  FAIL  $1"; FAIL=$((FAIL+1)); }
warn() { echo "  WARN  $1"; WARN=$((WARN+1)); }
hdr()  { echo ""; echo "=== $1 ==="; }

cd "$REPO"

# Portable Python: honour $PYTHON, else python3, python, or the Windows py launcher.
PY="${PYTHON:-}"
if [ -z "$PY" ]; then
  # Skip the Windows Store alias, which exists on PATH but does not run.
  for c in python python3 py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys" >/dev/null 2>&1; then PY="$c"; break; fi
  done
fi
py() { "$PY" "$@"; }

# ── 1. Float in proof files ────────────────────────────────────────────────
hdr "1. Float in proof files"
FLOATS=$(grep -ril Float paper/proofs/*.lean 2>/dev/null | grep -v Movie.lean || true)
if [[ -n "$FLOATS" ]]; then
  fail "Float found — files: $FLOATS"
  grep -rn Float paper/proofs/*.lean | grep -v Movie.lean | head -10 | sed 's/^/    /'
else
  ok "Zero Float (Movie.lean excluded)"
fi

# ── 2. Sorry stubs ─────────────────────────────────────────────────────────
hdr "2. Sorry stubs"
SORRIES=$(py paper/scripts/count_sorries.py paper/proofs/*.lean 2>&1)
COUNT=$(echo "$SORRIES" | sed -n 's/^total: //p')
if [[ "$COUNT" == "0" ]]; then
  ok "Zero active sorry stubs (comments ignored)"
else
  warn "${COUNT:-?} sorry stub(s) remain — see ISS-005/ISS-036"
  echo "$SORRIES" | grep -v '^total:' | sed 's/^/    /'
fi

# ── 3. Open research problems ──────────────────────────────────────────────
hdr "3. Open research problems"

STALE_PROBLEMS=$(py paper/scripts/check_stale_problem_labels.py \
  --pdf bld/papers/zoomable-somatic-field.pdf \
  --pdf bld/papers/lean-proofs-appendix.pdf 2>&1)
if [[ $? -eq 0 ]]; then
  ok "No stale resolved-problem labels in P11 or proof appendix"
else
  fail "Stale resolved-problem labels found — rebuild affected candidate PDFs"
  echo "$STALE_PROBLEMS" | sed 's/^/    /'
fi

RESEARCH_GAPS=$(grep -rn "GAP-[0-9]\|-- OP[0-9]" paper/proofs/*.lean 2>/dev/null | grep -v "CLOSED\|PROVED\|ISS-0" | sort -u || true)
if [[ -z "$RESEARCH_GAPS" ]]; then
  ok "No explicit proof-level research gaps"
else
  warn "Explicit proof-level research gaps remain — verify ISSUES.md tracking"
  echo "$RESEARCH_GAPS" | sed 's/^/    /'
fi

# ── 4. lean-proofs-appendix freshness ─────────────────────────────────────
hdr "4. lean-proofs-appendix + omnibus freshness"
APPENDIX="paper/soma/lean-proofs-appendix/lean-proofs-appendix.md"
LEAN_FILTER="paper/filters/lean-include.lua"
PDF_APPENDIX="bld/papers/lean-proofs-appendix.pdf"
if [[ ! -f "$PDF_APPENDIX" ]]; then
  fail "lean-appendix PDF missing — run: make lean-appendix"
elif find paper/proofs -name '*.lean' -newer "$PDF_APPENDIX" | grep -q . || [[ "$APPENDIX" -nt "$PDF_APPENDIX" ]] || [[ "$LEAN_FILTER" -nt "$PDF_APPENDIX" ]]; then
  fail "lean-appendix PDF stale — run: make lean-appendix"
else
  ok "lean-appendix PDF is current with filter-driven Lean sources"
fi
# omnibus freshness vs lean-appendix
[[ "bld/papers/omnibus-a4.pdf" -nt "$PDF_APPENDIX" ]] \
  && ok "omnibus-a4.pdf is newer than lean-appendix PDF" \
  || warn "omnibus may be stale vs lean-appendix — run: make uat-build"

# ── 5. PAPERS.yaml pending uploads ────────────────────────────────────────
hdr "5. PAPERS.yaml — pending Zenodo uploads"
PENDING=$(grep -A2 "status:" ../Dist/PAPERS.yaml 2>/dev/null | grep -E "pending-upload|needs-new-version" | wc -l || echo "?")
if [[ "$PENDING" == "0" ]]; then
  ok "All papers published"
else
  warn "$PENDING paper(s) with status pending-upload or needs-new-version — see ISS-001"
fi

# ── 6. Git status ──────────────────────────────────────────────────────────
hdr "6. Git working tree"
DIRTY=$(git status --porcelain 2>/dev/null)
if [[ -z "$DIRTY" ]]; then
  ok "Working tree clean"
else
  fail "Uncommitted changes — commit before release:"
  echo "$DIRTY" | sed 's/^/    /'
fi

# ── 7. Lean build ─────────────────────────────────────────────────────────
hdr "7. Lean build"
echo "  NOTE  Run 'bld' manually — takes several minutes"
echo "        Expected: Build completed successfully (3912 jobs) exit 0"
ok "Deferred to manual run"

# ── 8. Debug options left in proof files ──────────────────────────────────
hdr "8. Debug options in proof files"
DEBUG=$(grep -rn "set_option.*true\|#check\|#print\|#eval!\|set_option maxRecDepth\|set_option trace" \
        paper/proofs/*.lean 2>/dev/null | grep -v "^.*--" || true)
if [[ -z "$DEBUG" ]]; then
  ok "No debug options or #check/#print left in proof files"
else
  warn "Debug items found (review before release):"
  echo "$DEBUG" | sed 's/^/    /'
fi

# ── 9. PAPERS.yaml DOIs for published papers ───────────────────────────────
hdr "9. PAPERS.yaml — published papers have DOIs"
MISSING_DOI=$(py -c "
import yaml, sys
data = yaml.safe_load(open('../Dist/PAPERS.yaml', encoding='utf-8'))
missing = []
for section in data.values():
  if isinstance(section, list):
    for p in section:
      if p.get('status') == 'published' and not p.get('doi','').strip():
        missing.append(p.get('id','?'))
print('\n'.join(missing))
" 2>/dev/null || echo "")
if [[ -z "$MISSING_DOI" ]]; then
  ok "All published papers have DOIs"
else
  fail "Published papers missing DOI: $MISSING_DOI"
fi

# ── 10. Dist PDFs match PAPERS.yaml ──────────────────────────────────────
hdr "10. Dist PDFs — files listed in PAPERS.yaml exist"
py -c "
import yaml, os, sys
data = yaml.safe_load(open('../Dist/PAPERS.yaml', encoding='utf-8'))
missing = []
for section in data.values():
  if isinstance(section, list):
    for p in section:
      f = p.get('file','')
      if f and not os.path.exists(os.path.join('../Dist', f)):
        missing.append('  MISS  ../Dist/{}  ({})'.format(f, p.get('id', '?')))
for m in missing:
  print(m)
sys.exit(len(missing))
" 2>/dev/null
RC=$?
[[ $RC -eq 0 ]] && ok "All PAPERS.yaml file: entries found in Dist" || fail "$RC PDF(s) listed in PAPERS.yaml missing from Dist"

# ── 11. PNG refs in figure captions ──────────────────────────────────────
hdr "11. PNG filenames in figure captions"
PY_CHECK=$(py paper/scripts/check_caption_png_refs.py 2>&1)
if [[ $? -eq 0 ]]; then
  ok "No embedded PNG refs in captions"
else
  fail "PNG refs in captions — will print as literal text in PDF"
  echo "$PY_CHECK" | grep -v "^OK" | sed 's/^/    /'
fi

# ── 12. Cheatsheet booklet page counts ─────────────────────────────────────
hdr "12. Cheatsheet booklets"
CANONICAL_CHEATSHEET="bld/books/booklet-gateway.pdf"
if [[ ! -f "$CANONICAL_CHEATSHEET" ]]; then
  fail "Canonical cheatsheet missing — run: make cheatsheet"
else
  CHEATSHEET_PAGES=$(pdfinfo "$CANONICAL_CHEATSHEET" 2>/dev/null | awk '/^Pages:/ {print $2}')
  if [[ "$CHEATSHEET_PAGES" == "4" ]]; then
    ok "Canonical cheatsheet is exactly four pages"
  else
    fail "Canonical cheatsheet must be four pages; found ${CHEATSHEET_PAGES:-unknown}"
  fi
fi

BOOKLET_DIR="bld/books"
BOOKLET_MISSING=""
BOOKLET_WRONG=""
# books/T-Theory/Makefile builds the consciousness book's booklet as booklet-philosophy.
for domain in gateway physics complex-systems formal-mathematics neuroscience \
              philosophy computer-science music-arts clinical-psychology \
              psychiatry-asd social-science geophysics law ppe economics; do
  booklet="$BOOKLET_DIR/booklet-$domain.pdf"
  if [[ ! -f "$booklet" ]]; then
    BOOKLET_MISSING="$BOOKLET_MISSING $domain"
  else
    pages=$(pdfinfo "$booklet" 2>/dev/null | awk '/^Pages:/ {print $2}')
    [[ "$pages" == "4" ]] || BOOKLET_WRONG="$BOOKLET_WRONG $domain($pages)"
  fi
done
if [[ -n "$BOOKLET_MISSING" ]]; then
  fail "Missing four-page booklet(s):$BOOKLET_MISSING"
elif [[ -n "$BOOKLET_WRONG" ]]; then
  fail "Booklet page-count mismatch:$BOOKLET_WRONG"
else
  ok "All 15 booklets are exactly four pages"
fi

# ── 13. Lulu page caps ────────────────────────────────────────────────────
hdr "13. Lulu print page caps"
LULU_CHECK=$(py paper/scripts/check_lulu_pages.py 2>&1)
if [[ $? -eq 0 ]]; then
  ok "All registry-designated Lulu artifacts are within page limits"
else
  fail "Lulu page cap failure"
  echo "$LULU_CHECK" | sed 's/^/    /'
fi

hdr "14. Programme references stand on their own"
REFS_CHECK=$(py paper/scripts/check_programme_refs.py 2>&1)
if [[ $? -eq 0 ]]; then
  ok "No bare paper ids in built documents; registry mirror and instructions agree"
else
  fail "Programme reference check"
fi
echo "$REFS_CHECK" | sed 's/^/    /'

hdr "15. Nothing live depends on .OBSOLETE files"
OBSOLETE_CHECK=$(py paper/scripts/check_obsolete_refs.py 2>&1)
if [[ $? -eq 0 ]]; then
  ok "No code uses a .OBSOLETE path; no dangling references to renamed files"
else
  fail ".OBSOLETE reference check"
fi
echo "$OBSOLETE_CHECK" | sed 's/^/    /'

hdr "16. PDF front matter (paper/FORMAT.md)"
FRONT_CHECK=$(py paper/scripts/check_front_matter.py 2>&1)
if [[ $? -eq 0 ]]; then
  ok "Title, blank verso, abstract and contents on the right pages in every built PDF"
else
  fail "Front matter on the wrong pages"
fi
echo "$FRONT_CHECK" | tail -12 | sed 's/^/    /'

hdr "17. Text fits the page"
OVERFLOW_CHECK=$(py paper/scripts/check_text_overflow.py 2>&1)
if [[ $? -eq 0 ]]; then
  ok "No text past the text block and no overlapping text in any built PDF"
else
  fail "Text does not fit (long tokens, table cells, code lines)"
fi
echo "$OVERFLOW_CHECK" | grep -E '^FAIL|checked' | head -15 | sed 's/^/    /'

hdr "18. Issue register (ISSUES.md)"
ISSUES_CHECK=$(bin/issues-check 2>&1)
if [[ $? -eq 0 ]]; then
  ok "ISSUES.md tags, fields and epic detail files are valid (bin/issues-check)"
else
  fail "ISSUES.md metadata is invalid: run bin/issues-check"
fi
echo "$ISSUES_CHECK" | grep -E '^(FAIL|PASS)' | head -8 | sed 's/^/    /'

hdr "19. Sherlock concept registry (registry/concepts)"
CONCEPT_CHECK=$(py paper/scripts/check_concepts.py 2>&1)
if [[ $? -eq 0 ]]; then
  ok "Concepts resolve to Lean, papers and levels; no label claims more than its proof"
else
  fail "Concept registry: broken reference or a label the proof does not support"
fi
echo "$CONCEPT_CHECK" | grep -E '^(FAIL|[0-9]+ concepts)' | head -8 | sed 's/^/    /'
GAPS=$(echo "$CONCEPT_CHECK" | grep -c '^GAP' || true)
[[ "$GAPS" -gt 0 ]] && echo "    $GAPS gap(s): make concepts"

# ── Summary ────────────────────────────────────────────────────────────────
echo ""
echo "══════════════════════════════════════"
printf "  PASS: %-4s  WARN: %-4s  FAIL: %s\n" "$PASS" "$WARN" "$FAIL"
echo "══════════════════════════════════════"
[[ $FAIL -eq 0 ]]
