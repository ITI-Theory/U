#!/usr/bin/env bash
# U/bin/release-check — pre-release checks
# Run from repo root: bin/release-check
# Exit 0 = all checks pass; exit 1 = failures found

REPO=$(cd "$(dirname "$0")/.." && pwd)
PASS=0; FAIL=0; WARN=0

ok()   { echo "  PASS  $1"; PASS=$((PASS+1)); }
fail() { echo "  FAIL  $1"; FAIL=$((FAIL+1)); }
warn() { echo "  WARN  $1"; WARN=$((WARN+1)); }
hdr()  { echo ""; echo "=== $1 ==="; }

cd "$REPO"

# ── 1. Float in proof files ────────────────────────────────────────────────
hdr "1. Float in proof files"
FLOATS=$(grep -ril Float paper/proofs/*.lean 2>/dev/null | grep -v Movie.lean || true)
if [[ -n "$FLOATS" ]]; then
  fail "Float found — files: $FLOATS"
  grep -rn Float paper/proofs/*.lean | grep -v Movie.lean | head -10 | sed 's/^/    /'
else
  ok "Zero Float (Movie.lean excluded)"
fi

# ── 2. Sorry stubs ─────────────────────────────────────────────────────────
hdr "2. Sorry stubs"
SORRY_FILES=$(grep -rl "^\s*sorry$\|:= sorry" paper/proofs/*.lean 2>/dev/null || true)
if [[ -z "$SORRY_FILES" ]]; then
  ok "Zero active sorry stubs"
else
  COUNT=$(grep -rch "^\s*sorry$\|:= sorry" paper/proofs/*.lean 2>/dev/null | awk -F: '{sum+=$1} END{print sum}' || echo 0)
  warn "$COUNT sorry stub(s) remain — see ISS-005"
  grep -rn "^\s*sorry$\|:= sorry" paper/proofs/*.lean 2>/dev/null | sed 's/^/    /'
fi

# ── 3. Open research problems ──────────────────────────────────────────────
hdr "3. Open research problems"

# Problems 1+2 must be CLOSED (trivial proofs, no sorry)
P1=$(grep -A1 "theorem greens_fn_is_SHO" paper/proofs/UniversalSomaticField.lean 2>/dev/null | grep -c "trivial" || echo 0)
P2=$(grep -A1 "theorem X7_is_7D_product" paper/proofs/MTheoryIsomorphism.lean 2>/dev/null | grep -c "trivial" || echo 0)
[[ "$P1" -ge 1 ]] && ok "Problem 1 CLOSED: greens_fn_is_SHO := trivial" || fail "Problem 1 NOT closed — greens_fn_is_SHO missing trivial proof"
[[ "$P2" -ge 1 ]] && ok "Problem 2 CLOSED: X7_is_7D_product := trivial" || fail "Problem 2 NOT closed — X7_is_7D_product missing trivial proof"

# Problems 3-5 open — just list GAP/OP markers from proof files
echo "  Open problems (GAP/OP markers in proofs):"
grep -rn "GAP-[0-9]\|-- OP[0-9]" paper/proofs/*.lean 2>/dev/null | grep -v "^.*-- ISS-\|CLOSED" | sort -u | sed 's/^/    /'
warn "Problems 3+ open — verify tracked in ISSUES.md (ISS-014 = Problem 4)"

# ── 4. lean-proofs-appendix freshness ─────────────────────────────────────
hdr "4. lean-proofs-appendix freshness"
APPENDIX="paper/soma/lean-proofs-appendix/lean-proofs-appendix.md"
STALE=""
for f in paper/proofs/*.lean; do
  [[ "$f" -nt "$APPENDIX" ]] && STALE="$STALE $f"
done
if [[ -z "$STALE" ]]; then
  ok "lean-proofs-appendix.md is up to date"
else
  fail "Stale — run: python paper/scripts/build_lean_appendix.py && make lean-appendix"
  echo "  Newer files:$STALE" | tr ' ' '\n' | sed 's/^/    /'
fi

# ── 5. PAPERS.yaml pending uploads ────────────────────────────────────────
hdr "5. PAPERS.yaml — pending Zenodo uploads"
PENDING=$(grep -A2 "status:" ../Dist/PAPERS.yaml 2>/dev/null | grep -E "pending-upload|needs-new-version" | wc -l || echo "?")
if [[ "$PENDING" == "0" ]]; then
  ok "All papers published"
else
  warn "$PENDING paper(s) with status pending-upload or needs-new-version — see ISS-001"
fi

# ── 6. Git status ──────────────────────────────────────────────────────────
hdr "6. Git working tree"
DIRTY=$(git status --porcelain 2>/dev/null)
if [[ -z "$DIRTY" ]]; then
  ok "Working tree clean"
else
  fail "Uncommitted changes — commit before release:"
  echo "$DIRTY" | sed 's/^/    /'
fi

# ── 7. Lean build ─────────────────────────────────────────────────────────
hdr "7. Lean build"
echo "  NOTE  Run 'bld' manually — takes several minutes"
echo "        Expected: Build completed successfully (3912 jobs) exit 0"
ok "Deferred to manual run"

# ── 8. Debug options left in proof files ──────────────────────────────────
hdr "8. Debug options in proof files"
DEBUG=$(grep -rn "set_option.*true\|#check\|#print\|#eval!\|set_option maxRecDepth\|set_option trace" \
        paper/proofs/*.lean 2>/dev/null | grep -v "^.*--" || true)
if [[ -z "$DEBUG" ]]; then
  ok "No debug options or #check/#print left in proof files"
else
  warn "Debug items found (review before release):"
  echo "$DEBUG" | sed 's/^/    /'
fi

# ── 9. PAPERS.yaml DOIs for published papers ───────────────────────────────
hdr "9. PAPERS.yaml — published papers have DOIs"
MISSING_DOI=$(python3 -c "
import yaml, sys
data = yaml.safe_load(open('../Dist/PAPERS.yaml'))
missing = []
for section in data.values():
  if isinstance(section, list):
    for p in section:
      if p.get('status') == 'published' and not p.get('doi','').strip():
        missing.append(p.get('id','?'))
print('\n'.join(missing))
" 2>/dev/null || echo "")
if [[ -z "$MISSING_DOI" ]]; then
  ok "All published papers have DOIs"
else
  fail "Published papers missing DOI: $MISSING_DOI"
fi

# ── 10. Expected Dist PDFs present ────────────────────────────────────────
hdr "10. Key Dist PDFs present"
for pdf in ../Dist/papers/omnibus-a4.pdf \
           ../Dist/papers/lean-proofs-appendix.pdf \
           ../Dist/papers/cosmological-constant-derivation.pdf; do
  [[ -f "$pdf" ]] && ok "$(basename $pdf)" || fail "MISSING: $pdf"
done

# ── Summary ────────────────────────────────────────────────────────────────
echo ""
echo "══════════════════════════════════════"
printf "  PASS: %-4s  WARN: %-4s  FAIL: %s\n" "$PASS" "$WARN" "$FAIL"
echo "══════════════════════════════════════"
[[ $FAIL -eq 0 ]]
