#!/usr/bin/env bash
# U/bin/release-build — rebuild release candidates in U from current source
# Run from repo root: bin/release-build
# Run BEFORE bin/release-check to ensure PDFs are current.
# This script never copies to ../Dist: Dist is reserved for approved releases.

REPO=$(cd "$(dirname "$0")/.." && pwd)
cd "$REPO"

ok()  { echo "  OK    $1"; }
fail(){ echo "  FAIL  $1"; exit 1; }
hdr() { echo ""; echo "=== $1 ==="; }

# ── 1. Regenerate lean-proofs-appendix.md ─────────────────────────────────
hdr "1. Regenerate lean-proofs-appendix.md"
python paper/scripts/build_lean_appendix.py \
  && ok "lean-proofs-appendix.md regenerated" \
  || fail "build_lean_appendix.py failed"

# ── 2. Rebuild lean-appendix PDF ──────────────────────────────────────────
hdr "2. Rebuild lean-proofs-appendix PDF"
make -C paper lean-appendix \
  && ok "lean-proofs-appendix.pdf built" \
  || fail "make lean-appendix failed"

# ── 3. Rebuild omnibus (A4 + Royal) ───────────────────────────────────────
hdr "3. Rebuild omnibus"
make -C paper omnibus \
  && ok "omnibus-a4.pdf + omnibus-royal.pdf built" \
  || fail "make omnibus failed"

# ── 4. Rebuild Fractal Programme candidates ───────────────────────────────
hdr "4. Rebuild Fractal Programme candidates"
make -C Part2/fractal-programme bld/cheatsheet-master.pdf all vol1 vol2 fractal-thesis \
  && ok "master cheatsheet, 15 domain books, volumes, and fractal thesis built" \
  || fail "Fractal Programme build failed"

# ── 5. Candidate hand-off ─────────────────────────────────────────────────
hdr "5. Candidate hand-off"
echo ""
echo "  Built candidates remain in U. Do not copy them to ../Dist yet."
echo "  First: run bin/release-check and complete the relevant QA review."
echo "  Then: promote only approved candidate PDFs into the Dist release repository."
echo ""
echo "  Next: run bin/release-check to verify everything is clean."
